# Copy to .env and fill in. Never commit .env.
PORT=3000
# 32+ random characters:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# --- GitHub as the database (recommended) ---
# A PRIVATE repo you create, e.g. yourname/codester-data (it needs at least one commit, e.g. a README).
GITHUB_REPO=
# Fine-grained personal access token limited to that one repo, permission: Contents = Read and write
GITHUB_TOKEN=
GITHUB_BRANCH=main
# Leave both GITHUB_* empty to store data in a local file instead (development only)

# Videos are cached here and also committed to the repo. GitHub mode default max is 25 MB per video.
UPLOAD_DIR=uploads
# MAX_VIDEO_MB=25

# Followers needed for the blue tick (automatic). Default 1000.
# VERIFY_AT=1000
