# Copy to .env and fill in. Never commit .env.
PORT=3000
DATABASE_URL=postgres://codester:CHANGE_ME@localhost:5432/codester
# Set true for managed databases that require SSL (Render, Railway, Neon, Supabase...)
DATABASE_SSL=false
# 32+ random characters:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Where uploaded videos are stored (use a persistent disk / volume in production)
UPLOAD_DIR=uploads
MAX_VIDEO_MB=100
